PROJECT_NAME=FESTORA API
VERSION=1.0.0
DESCRIPTION=Backend REST API for FESTORA - College Fest Management Platform
API_V1_PREFIX=/api

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Config (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=festora_db
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/festora_db

# Security & JWT
SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# FEST AI Config
OPENAI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
